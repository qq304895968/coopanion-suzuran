    {
      "id": "early-roster",
      "phase": "early",
      "tags": ["开局", "阵容"],
      "text": "前两层先把阵容凑齐：至少一个能扛的、一个治疗、两个输出。阵容没齐之前别把钱全花在收藏品上。"
    },
    {
      "id": "early-difficulty",
      "phase": "early",
      "tags": ["难度"],
      "text": "新主题先从低难度打，把节点类型和结局条件摸清楚，再往上加难度。"
    },
    {
      "id": "early-squad",
      "phase": "early",
      "tags": ["分队"],
      "text": "分队决定开局资源和思路，先想好这局走什么阵容再选分队，不要反过来。"
    },
    {
      "id": "hope",
      "phase": "any",
      "tags": ["希望", "招募"],
      "text": "希望不够时宁缺毋滥：招一个能立刻上场的高星，比招两个占位置的低星强。"
    },
    {
      "id": "recruit-order",
      "phase": "early",
      "tags": ["招募"],
      "text": "招募券优先补缺口：先阻挡、再治疗、最后输出。缺什么补什么，别按稀有度排队。"
    },
    {
      "id": "relic-value",
      "phase": "mid",
      "tags": ["收藏品", "源石锭"],
      "text": "源石锭优先买能马上改变战力的收藏品；纯数值堆叠的收藏品在后期收益更低。"
    },
    {
      "id": "event-cost",
      "phase": "any",
      "tags": ["事件"],
      "text": "事件节点里的选项要看代价：掉生命、掉希望、给负面状态的选项，先想清楚这局还扛不扛得住。"
    },
    {
      "id": "life",
      "phase": "any",
      "tags": ["生命"],
      "text": "掉血不等于崩盘。能保住关键干员和阵容完整性时，丢一点生命换资源是划算的。"
    },
    {
      "id": "ending-check",
      "phase": "late",
      "tags": ["结局"],
      "text": "这一主题的结局往往需要特定收藏品或事件组合。进最终层之前先确认自己有没有齐条件，别到门口才发现走的是普通结局。"
    },
    {
      "id": "late-upgrade",
      "phase": "late",
      "tags": ["后期"],
      "text": "第四层之后优先补短板，而不是继续堆输出：一个能救场的治疗或阻挡，价值往往高于第三个输出。"
    },
    {
      "id": "retreat",
      "phase": "any",
      "tags": ["失误"],
      "text": "打不过就撤，保干员比硬打通关重要；撤退损失的费用通常比整队倒下便宜。"
    },
