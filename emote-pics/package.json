{
  "name": "cortico-world-emote-pics",
  "version": "0.3.0",
  "type": "module",
  "description": "让桌宠发文字消息时也能带图。你只需按情绪建立文件夹（如「开心」「眨眼」），在面板里为 19 种表情各自绑定文件夹。当桌宠表达对应情绪时，会根据你设定的概率和冷却时间，从对应情绪文件夹内随机挑一张图跟着文字发出。纯本地读取（支持常见图片格式，单张≤5MiB），发出的图片在对话页和桌面窗口均可显示。（建议和大肥鱼表情包配合食用）",
  "license": "MIT",
  "keywords": [
    "cortico-world",
    "cortico"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.28.6",
  "main": "./src/index.ts",
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "对话表情包",
    "icon": "assets/icon.png",
    "webUiClient": "dist/webui-20261029-3.js",
    "webUiStyle": "dist/webui-20261029-3.css",
    "tags": [
      "internal-state"
    ],
    "describe": "describe.json"
  },
  "files": [
    "src",
    "dist",
    "assets",
    "README.md",
    "CHANGELOG.md",
    "describe.json"
  ],
  "scripts": {
    "build": "node scripts/build-webui.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "cortico": "^0.2.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
