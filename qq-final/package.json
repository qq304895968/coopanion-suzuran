    "label": "QQ_bot",
    "tags": [
      "im",
      "qq",
      "external-setup"
    ],
    "webUiClient": "dist/console.js",
    "webUiStyle": "dist/console.css",
    "describe": "describe.json"
  },
  "engines": {
    "node": ">=22.15"
  },
  "dependencies": {
    "ws": "^8.22.0"
  },
  "packageManager": "pnpm@11.28.6",
  "devDependencies": {
    "@types/node": "22.19.0",
    "cortico": "0.2.8",
    "typescript": "5.7.3",
    "vitest": "2.1.9",
    "esbuild": "0.28.2",
    "tsx": "4.19.2",
    "@types/ws": "^8.5.13"
  },
  "scripts": {
    "build": "node scripts/build-webui.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json --noEmit"
  }
